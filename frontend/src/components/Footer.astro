---
const today = new Date();
---

<footer>
	<div class="inner">
		<span>&copy; {today.getFullYear()} gelog</span>
		<a href="https://github.com/kimgeuneon" target="_blank" rel="noopener">GitHub</a>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--content);
		margin: 0 auto;
		padding: 1.6rem 1.25rem 2.4rem;
		font-size: 0.9rem;
		color: var(--muted);
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
</style>
