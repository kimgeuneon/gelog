---
import { withBase } from '@/shared/lib/url';

const today = new Date();
---

<footer>
	<div class="inner">
		<span class="mono">&copy; {today.getFullYear()} gelog</span>
		<a class="mono" href={withBase('/rss.xml')}>RSS</a>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--wide);
		margin: 0 auto;
		padding: var(--s-4);
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--text);
	}
</style>
