---
import { withBase } from '@/shared/lib/url';
import { SITE_TITLE } from '@/config/site';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
	<nav>
		<a href={withBase('/')} class="brand">
			<span class="dot" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<div class="links">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<ThemeToggle />
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--wide);
		height: 56px;
		margin: 0 auto;
		padding: 0 var(--s-4);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--s-2);
		font-family: var(--mono);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text);
		text-decoration: none;
	}
	.dot {
		width: 8px;
		height: 8px;
		background: var(--accent);
		border-radius: 50%;
	}
	.links {
		display: flex;
		align-items: center;
		gap: var(--s-1);
	}
</style>
