---
type Props = { lead?: string; eyebrow?: string };

const { lead, eyebrow } = Astro.props;
---

<section class="hero">
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	<h1><slot /></h1>
	{lead && <p class="lead">{lead}</p>}
</section>

<style>
	.hero {
		padding-bottom: var(--s-6);
	}
	.eyebrow {
		margin: 0 0 var(--s-3);
	}
	h1 {
		margin: 0;
		font-size: var(--t-3);
		line-height: 1.25;
	}
	.lead {
		margin: var(--s-3) 0 0;
		max-width: 60ch;
		font-size: var(--t-1);
		line-height: 1.6;
		color: var(--muted);
		text-wrap: pretty;
	}
</style>
