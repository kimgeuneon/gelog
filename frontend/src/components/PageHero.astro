---
import { withBase } from '../lib/url';
type Props = { lead?: string };

const { lead } = Astro.props;
---

<section class="hero">
	<img class="logo" src={withBase('/favicon.svg')} alt="gelog 로고" width="72" height="72" />
	<h1><slot /></h1>
	{lead && <p class="lead">{lead}</p>}
</section>

<style>
	.hero {
		padding: 2.5rem 0 3.5rem;
	}
	.logo {
		display: block;
		width: 72px;
		height: 72px;
		margin-bottom: 1.6rem;
		border-radius: 20px;
		box-shadow: 0 10px 34px rgba(124, 92, 255, 0.42);
	}
	h1 {
		margin: 0;
		font-size: clamp(2.1rem, 6vw, 3.2rem);
		font-weight: 800;
		line-height: 1.22;
		letter-spacing: -0.035em;
	}
	.lead {
		margin: 1.1rem 0 0;
		font-size: 1.1rem;
		line-height: 1.65;
		color: var(--muted);
	}
</style>
