---
import { postUrl, withBase } from '@/shared/lib/url';
import type { Post } from '@/shared/lib/posts';

type Props = { currentId: string; posts: Post[]; prev: Post | null; next: Post | null };

const { currentId, posts, prev, next } = Astro.props;
const href = (p: Post) => postUrl(p.id);
---

<nav class="post-nav" aria-label="이전 글과 다음 글">
	{
		prev ? (
			<a class="nav-item" href={href(prev)}>
				<span class="nav-label">← 이전 글</span>
				<span class="nav-title">{prev.data.title}</span>
			</a>
		) : (
			<span class="nav-item empty">
				<span class="nav-label">← 이전 글</span>
				<span class="nav-title">첫 글입니다</span>
			</span>
		)
	}
	{
		next ? (
			<a class="nav-item next" href={href(next)}>
				<span class="nav-label">다음 글 →</span>
				<span class="nav-title">{next.data.title}</span>
			</a>
		) : (
			<span class="nav-item next empty">
				<span class="nav-label">다음 글 →</span>
				<span class="nav-title">가장 최근 글입니다</span>
			</span>
		)
	}
</nav>

<section class="post-list">
	<div class="section-head">
		<h2>글 목록</h2>
		<a href={withBase('/blog')}>전체 보기 →</a>
	</div>
	<ol>
		{
			posts.map((p) =>
				p.id === currentId ? (
					<li class="current" aria-current="page">
						<span>{p.data.title}</span>
						<span class="here">지금 읽는 글</span>
					</li>
				) : (
					<li>
						<a href={href(p)}>{p.data.title}</a>
					</li>
				),
			)
		}
	</ol>
</section>

<style>
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		margin-top: 64px;
		padding-top: 32px;
		border-top: 1px solid var(--border-strong);
	}
	.nav-item {
		display: flex;
		flex-direction: column;
		gap: 4px;
		color: inherit;
		text-decoration: none;
	}
	.nav-item.next {
		text-align: right;
	}
	.nav-label {
		font-size: 0.85rem;
		color: var(--muted);
	}
	.nav-title {
		font-weight: 700;
		line-height: 1.45;
	}
	a.nav-item:hover .nav-title {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}
	.nav-item.empty .nav-title {
		font-weight: 400;
		color: var(--muted);
	}
	.post-list {
		margin-top: 64px;
	}
	.post-list ol {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--border);
	}
	.post-list li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
		padding: 8px 0;
		border-bottom: 1px solid var(--border);
	}
	.post-list li a {
		color: var(--text);
		text-decoration: none;
	}
	.post-list li a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.post-list li.current {
		font-weight: 700;
	}
	.here {
		flex-shrink: 0;
		font-size: 0.8rem;
		font-weight: 400;
		color: var(--muted);
	}
	@media (max-width: 600px) {
		.post-nav {
			grid-template-columns: 1fr;
			gap: 16px;
		}
		.nav-item.next {
			text-align: left;
		}
	}
</style>
