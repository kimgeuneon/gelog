---
import { postUrl, withBase } from '../lib/url';
import type { Post } from '../lib/posts';

type Props = { currentId: string; posts: Post[]; prev: Post | null; next: Post | null };

const { currentId, posts, prev, next } = Astro.props;
const href = (p: Post) => postUrl(p.id);
---

<nav class="post-nav" aria-label="이전 글과 다음 글">
	{
		prev ? (
			<a class="card nav-card" href={href(prev)}>
				<span class="card-meta">← 이전 글</span>
				<span class="nav-title">{prev.data.title}</span>
			</a>
		) : (
			<span class="nav-card empty">
				<span class="card-meta">← 이전 글</span>
				<span class="nav-title">첫 글입니다</span>
			</span>
		)
	}
	{
		next ? (
			<a class="card nav-card next" href={href(next)}>
				<span class="card-meta">다음 글 →</span>
				<span class="nav-title">{next.data.title}</span>
			</a>
		) : (
			<span class="nav-card next empty">
				<span class="card-meta">다음 글 →</span>
				<span class="nav-title">가장 최근 글입니다</span>
			</span>
		)
	}
</nav>

<section class="post-list">
	<div class="section-head">
		<h2>글 목록</h2>
		<a href={withBase('/blog')}>전체 보기 →</a>
	</div>
	<ol>
		{
			posts.map((p) =>
				p.id === currentId ? (
					<li class="current" aria-current="page">
						<span>{p.data.title}</span>
						<span class="badge">지금 읽는 글</span>
					</li>
				) : (
					<li>
						<a href={href(p)}>{p.data.title}</a>
					</li>
				),
			)
		}
	</ol>
</section>

<style>
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 4rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
	}
	.nav-card {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.1rem 1.3rem;
	}
	.nav-card.next {
		text-align: right;
	}
	.nav-title {
		font-weight: 700;
		line-height: 1.4;
		color: var(--text);
	}
	.nav-card.empty {
		border: 1px dashed var(--border);
		border-radius: var(--radius);
		opacity: 0.6;
	}
	.nav-card.empty .nav-title {
		font-weight: 500;
		color: var(--muted);
	}
	.post-list {
		margin-top: 3rem;
	}
	.post-list ol {
		margin: 0;
		padding: 0;
		list-style: none;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}
	.post-list li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid var(--border);
	}
	.post-list li:last-child {
		border-bottom: none;
	}
	.post-list li a,
	.post-list li.current span:first-child {
		flex: 1;
		padding: 0.85rem 1.2rem;
	}
	.post-list li a {
		color: var(--text);
		text-decoration: none;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}
	.post-list li a:hover {
		color: var(--accent);
		background: var(--surface-2);
	}
	.post-list li.current {
		font-weight: 700;
		color: var(--accent);
		background: var(--accent-soft);
	}
	.badge {
		flex-shrink: 0;
		margin-right: 1.2rem;
		padding: 0.15rem 0.6rem;
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--accent);
		border: 1px solid var(--accent);
		border-radius: 999px;
	}
	@media (max-width: 600px) {
		.post-nav {
			grid-template-columns: 1fr;
		}
		.nav-card.next {
			text-align: left;
		}
	}
</style>
