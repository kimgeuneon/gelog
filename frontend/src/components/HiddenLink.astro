---
import { withBase } from '@/shared/lib/url';

type Props = { href: string; label: string };

// 평소에는 보이지 않고, 마우스를 올리거나 키보드로 포커스하면 나타나는 링크.
const { href, label } = Astro.props;
---

<a class="hidden-link" href={withBase(href)} aria-label={label}>
	<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
		<rect x="5" y="11" width="14" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="2" />
		<path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
	</svg>
</a>

<style>
	.hidden-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.9rem;
		height: 1.9rem;
		margin-left: 0.35rem;
		vertical-align: middle;
		color: var(--accent);
		border-radius: 999px;
		opacity: 0;
		transition:
			opacity 0.2s ease,
			background 0.2s ease;
	}
	.hidden-link:hover,
	.hidden-link:focus-visible {
		opacity: 1;
		background: var(--accent-soft);
	}
</style>
