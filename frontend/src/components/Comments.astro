---
type Props = { slug: string };

const { slug } = Astro.props;
// 백엔드 주소. 빌드할 때 PUBLIC_API_URL이 없으면 댓글 영역을 그리지 않는다.
const apiUrl = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/$/, '');
---

{
	apiUrl && (
		<section class="comments" data-comments data-api={apiUrl} data-slug={slug}>
			<div class="section-head">
				<h2>
					댓글 <span class="count" data-count />
				</h2>
			</div>

			<ul class="comment-list" data-list />
			<p class="empty" data-empty hidden>
				아직 댓글이 없습니다. 첫 댓글을 남겨 주세요.
			</p>

			<form class="comment-form panel" data-form>
				<div class="row">
					<input class="field" name="nickname" placeholder="닉네임" maxlength="30" required autocomplete="nickname" />
					<input
						class="field"
						name="password"
						type="password"
						placeholder="비밀번호 (삭제할 때 필요)"
						minlength="4"
						maxlength="64"
						required
						autocomplete="new-password"
					/>
				</div>
				<textarea class="field" name="content" placeholder="댓글을 입력하세요" maxlength="1000" rows="4" required />
				<div class="actions">
					<p class="status" data-status role="status" />
					<button class="btn-primary" type="submit">등록</button>
				</div>
			</form>
		</section>
	)
}

<script>
	import { mountComments } from '../lib/comments';

	document.querySelectorAll<HTMLElement>('[data-comments]').forEach(mountComments);
</script>

<style>
	.comment-form {
		display: grid;
		gap: 0.7rem;
	}
	.comments {
		margin-top: 4rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
	}
	.count {
		margin-left: 0.3rem;
		font-size: 0.9em;
		color: var(--accent);
	}
	.comment-list {
		display: grid;
		gap: 0.8rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}
	.comment-list :global(li) {
		padding: 1rem 1.2rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.comment-list :global(.head) {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin-bottom: 0.35rem;
	}
	.comment-list :global(time) {
		font-size: 0.8rem;
		color: var(--muted);
	}
	.comment-list :global(.delete) {
		margin-left: auto;
		padding: 0;
		font-size: 0.8rem;
		color: var(--muted);
		background: none;
		border: none;
		cursor: pointer;
	}
	.comment-list :global(.delete:hover) {
		color: #e5484d;
	}
	.comment-list :global(p) {
		margin: 0;
		white-space: pre-wrap;
		word-break: break-word;
	}
	.empty {
		margin: 0 0 1.5rem;
		color: var(--muted);
	}
	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.7rem;
	}
	.actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	@media (max-width: 600px) {
		.row {
			grid-template-columns: 1fr;
		}
	}
</style>
