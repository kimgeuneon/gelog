---
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';

type Props = {
	title: string;
	description: string;
	noindex?: boolean;
	/** 넓은 레이아웃(홈 벤토, 목차가 있는 글)일 때 true */
	wide?: boolean;
	transitions?: boolean;
};

const { title, description, noindex = false, wide = false, transitions = true } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} noindex={noindex} transitions={transitions} />
	</head>
	<body>
		<Header />
		<main class:list={{ wide }}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	/* 가로 넘침 차단. global.css에도 있지만 html/body를 그리는 이 파일에 함께 둔다. */
	html,
	body {
		overflow-x: clip;
	}
</style>
