---
import { withBase } from '@/shared/lib/url';
import PageHero from '@/components/PageHero.astro';
import PostCard from '@/components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/config/site';
import Page from '@/layouts/Page.astro';
import { getSortedPosts } from '@/shared/lib/posts';

const posts = (await getSortedPosts()).slice(0, 6);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<PageHero lead={`${SITE_TITLE} · ${SITE_DESCRIPTION}`}>
		안녕하세요.<br />
		김근언입니다.<br />
		<span class="gradient-text">괴물이 되어가는 중.</span>
	</PageHero>

	<section>
		<div class="section-head">
			<h2>최근 글</h2>
			<a href={withBase('/blog')}>전체 보기 →</a>
		</div>
		<div class="card-grid">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</Page>
