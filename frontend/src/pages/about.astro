---
import PageHero from '../components/PageHero.astro';
import { SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Page title={SITE_TITLE} description="김근언 자기소개">
	<PageHero lead={`${SITE_TITLE} · @kimgeuneon`}>
		안녕하세요.<br />
		김근언입니다.<br />
		<span class="gradient-text">괴물이 되어가는 중.</span>
	</PageHero>

	<section>
		<div class="section-head">
			<h2>링크</h2>
		</div>
		<div class="card-grid">
			<a class="card" href="https://github.com/kimgeuneon" target="_blank" rel="noopener">
				<span class="card-meta">GitHub</span>
				<h3 class="card-title">kimgeuneon</h3>
				<span class="card-more">열기 →</span>
			</a>
			<a class="card" href={`${base}/blog`}>
				<span class="card-meta">Blog</span>
				<h3 class="card-title">모든 글 보기</h3>
				<span class="card-more">열기 →</span>
			</a>
		</div>
	</section>
</Page>
