---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getSortedPosts, type Post, withNeighbors } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return withNeighbors(posts).map(({ post, prev, next }) => ({
		params: { slug: post.id },
		props: { post, posts, prev, next },
	}));
}

type Props = { post: Post; posts: Post[]; prev: Post | null; next: Post | null };

const { post, posts, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} id={post.id} posts={posts} prev={prev} next={next}>
	<Content />
</BlogPost>
