---
import HiddenLink from '@/components/HiddenLink.astro';
import PageHero from '@/components/PageHero.astro';
import PostCard from '@/components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/config/site';
import Page from '@/layouts/Page.astro';
import { getSortedPosts } from '@/shared/lib/posts';

const posts = await getSortedPosts();
---

<Page title={`Blog · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<PageHero eyebrow={`글 ${posts.length}개`} lead="로봇, 평가, 인프라, 그리고 그 과정에서 배운 것들을 적습니다.">
		모든 글<HiddenLink href="/private" label="Private" />
	</PageHero>

	<ol class="entries">
		{posts.map((post) => <PostCard post={post} />)}
	</ol>
</Page>
