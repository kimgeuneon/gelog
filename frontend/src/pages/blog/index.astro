---
import HiddenLink from '@/components/HiddenLink.astro';
import PageHero from '@/components/PageHero.astro';
import PostCard from '@/components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/config/site';
import Page from '@/layouts/Page.astro';
import { getSortedPosts } from '@/shared/lib/posts';

const posts = await getSortedPosts();
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<PageHero lead={`${SITE_TITLE} · 글 ${posts.length}개`}>
		블로그<br />
		<span class="gradient-text">모든 글</span>
	</PageHero>

	<section>
		<div class="section-head">
			<h2>
				전체 글<HiddenLink href="/private" label="Private" />
			</h2>
		</div>
		<div class="card-grid">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</Page>
