---
import PageHero from '@/components/PageHero.astro';
import Page from '@/layouts/Page.astro';
import PrivateBoardIsland from '@/features/private-board/ui/PrivateBoardIsland';

// 암호화된 게시판(봉투). 아직 seal 전이라 파일이 없으면 빈 게시판으로 둔다.
const sealedFiles = import.meta.glob('../data/private.sealed.json', { eager: true, import: 'default' });
const sealed = Object.values(sealedFiles)[0] ?? null;
---

<Page title="Private" description="비밀번호가 있어야 볼 수 있는 게시판" noindex>
	<PageHero lead="비밀번호를 입력해야 볼 수 있는 게시판입니다.">
		<span class="gradient-text">Private</span>
	</PageHero>

	<section class="private">
		{
			sealed ? (
				<>
					<script type="application/json" id="private-sealed" set:html={JSON.stringify(sealed)} />
					<PrivateBoardIsland client:load sealedId="private-sealed" />
				</>
			) : (
				<p class="empty">아직 게시판에 글이 없습니다.</p>
			)
		}
	</section>
</Page>

<style>
	/* 안쪽은 React가 그리므로 .private 아래를 :global로 잡는다 */
	.private :global(.lock) {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		max-width: 26rem;
	}
	.private :global(.lock label) {
		font-weight: 700;
	}
	.private :global(.lock-row) {
		display: flex;
		gap: 0.5rem;
	}
	.private :global(.empty) {
		color: var(--muted);
	}
	.private :global(.back) {
		margin-top: 2.5rem;
	}
	.private :global(.deck-player) {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		margin-bottom: 2rem;
	}
	.private :global(.deck-frame) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #000;
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.private :global(.deck-frame:fullscreen) {
		border: none;
		border-radius: 0;
	}
	.private :global(.deck-bar) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.88rem;
		color: var(--muted);
	}
</style>
