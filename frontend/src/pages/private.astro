---
import PageHero from '@/components/PageHero.astro';
import Page from '@/layouts/Page.astro';
import PrivateBoardIsland from '@/features/private-board/ui/PrivateBoardIsland';

import { withBase } from '@/shared/lib/url';

// 암호화된 파일은 public/private/ 에 정적으로 배포되고, 브라우저가 비밀번호로 직접 연다.
---

<Page title="Private" description="비밀번호가 있어야 볼 수 있는 게시판" noindex>
	<PageHero lead="비밀번호를 입력해야 볼 수 있는 게시판입니다.">
		<span class="gradient-text">Private</span>
	</PageHero>

	<section class="private">
		<PrivateBoardIsland client:load baseUrl={withBase('/private/')} />
	</section>
</Page>

<style>
	/* 안쪽은 React가 그리므로 .private 아래를 :global로 잡는다 */
	.private :global(.lock) {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		max-width: 26rem;
	}
	.private :global(.lock label) {
		font-weight: 700;
	}
	.private :global(.lock-row) {
		display: flex;
		gap: 0.5rem;
	}
	.private :global(.empty) {
		color: var(--muted);
	}
	.private :global(.deck-loading) {
		color: var(--muted);
	}
	.private :global(.back) {
		margin-top: 2.5rem;
	}
	.private :global(.deck-player) {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		margin-bottom: 2rem;
	}
	.private :global(.deck-frame) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #000;
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.private :global(.deck-frame:fullscreen) {
		border: none;
		border-radius: 0;
	}
	.private :global(.deck-bar) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.88rem;
		color: var(--muted);
	}
</style>
