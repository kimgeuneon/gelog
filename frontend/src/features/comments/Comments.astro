---
import CommentsIsland from './ui/CommentsIsland';

type Props = { slug: string };

const { slug } = Astro.props;
// 백엔드 주소. 빌드할 때 PUBLIC_API_URL이 없으면 댓글 영역을 그리지 않는다.
const apiUrl = (import.meta.env.PUBLIC_API_URL ?? '').replace(/\/$/, '');
---

{
	apiUrl && (
		<section class="comments">
			<CommentsIsland client:visible apiUrl={apiUrl} slug={slug} />
		</section>
	)
}

<style>
	/* 안쪽은 React가 그리므로 Astro 범위 속성이 없다. .comments 아래를 :global로 잡는다. */
	.comments {
		margin-top: 4rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
	}
	.comments :global(.count) {
		margin-left: 0.3rem;
		font-size: 0.9em;
		color: var(--accent);
	}
	.comments :global(.comment-list) {
		display: grid;
		gap: 0.8rem;
		margin: 0 0 1.5rem;
		padding: 0;
		list-style: none;
	}
	.comments :global(.comment-list li) {
		padding: 1rem 1.2rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}
	.comments :global(.comment-list .head) {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin-bottom: 0.35rem;
	}
	.comments :global(.comment-list time) {
		font-size: 0.8rem;
		color: var(--muted);
	}
	.comments :global(.comment-list .delete) {
		margin-left: auto;
		padding: 0;
		font-size: 0.8rem;
		color: var(--muted);
		background: none;
		border: none;
		cursor: pointer;
	}
	.comments :global(.comment-list .delete:hover) {
		color: #e5484d;
	}
	.comments :global(.comment-list p) {
		margin: 0;
		white-space: pre-wrap;
		word-break: break-word;
	}
	.comments :global(.empty) {
		margin: 0 0 1.5rem;
		color: var(--muted);
	}
	.comments :global(.comment-form) {
		display: grid;
		gap: 0.7rem;
	}
	.comments :global(.row) {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.7rem;
	}
	.comments :global(.actions) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	@media (max-width: 600px) {
		.comments :global(.row) {
			grid-template-columns: 1fr;
		}
	}
</style>
